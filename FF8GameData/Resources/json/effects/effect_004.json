 "parts": [
  {
   "id": 0,
   "key": "emitter",
   "title": "Emitter",
   "doc": "One per action, on its target: starts the rune sequencer, plays the sound, lets the next action start, gives the result; when the last rune's column settles, a screen fade and the big rune (draws nothing)"
  },
  {
   "id": 1,
   "key": "runes",
   "title": "Runes",
   "doc": "Prim models on a circle around the target, one a tick, each fading in and spinning, then shrinking out"
  },
  {
   "id": 2,
   "key": "columns",
   "title": "Columns",
   "doc": "A column on each rune: it grows, settles and flashes (the last one's starts the big rune), flashes again then fades out"
  },
  {
   "id": 3,
   "key": "motes",
   "title": "Motes",
   "doc": "Flipbooks spiralling in towards each rune while it fades in"
  },
  {
   "id": 4,
   "key": "glows",
   "title": "Glows",
   "doc": "A flipbook on the ground under each rune, brightening, pulsing when the big rune starts, then fading"
  },
  {
   "id": 5,
   "key": "big",
   "title": "Big rune",
   "doc": "A prim model over the target, fading in (its sprites and rings) then out"
  },
  {
   "id": 6,
   "key": "sprites",
   "title": "Sprites",
   "doc": "Flipbooks around the big rune while it fades in, their frames and angles at random, brightening then dimming"
  },
  {
   "id": 7,
   "key": "morph",
   "title": "Morphing rings",
   "doc": "Prim models whose vertices blend from one shape to another while they fade"
  },
  {
   "id": 8,
   "key": "flash",
   "title": "Flash",
   "doc": "A textured quad on the target's top that jumps up and falls back"
  }
 ],
 "groups": [
  {
