 "groups": [
  {
   "key": "ring.start",
   "label": "Start",
   "doc": "The emitter starts the ring at its tick Delay (0: its first), Above over the target's feet; it climbs from there"
  },
  {
   "key": "ring.colour",
   "label": "Colour",
   "doc": "Each piece's colour = its own x this / 128 (128: as it is), one value per channel"
  },
  {
   "key": "ring.steps",
   "label": "Steps",
   "doc": "step n = ring tick x Per tick + k (k = 0 .. Per tick - 1); its angle = n x Angle. Each ring tick the ring goes through its Per tick steps and is drawn at the last one; a sparkle is born at every step. It turns Per tick x Angle per tick"
  },
  {
   "key": "ring.radius",
   "label": "Radius",
   "doc": "radius = target's radius x Times / Divided by (whole numbers), then at most At most. At step n the ring is at centre + (sin(angle) x radius, height, cos(angle) x radius)"
  },
  {
   "key": "ring.climb",
   "label": "Climb speed",
   "doc": "rise per step = ((target's height + Target height +) / Every) / Per tick (whole numbers, rounded toward 0). The ring starts at the target's feet and rises at this speed until it ends (its ending flipbook done, its sparkles and motes gone): after Every ticks it is Target height + over the target's top, then it goes on"
  },
  {
   "key": "ring.ending",
   "label": "Ending flipbook",
   "doc": "From ring tick From tick the ring plays this sequence, one frame per tick, up to Last frame, then ends once its sparkles and motes are gone: it lives about From tick + Last frame + 1 ticks"
  },
  {
   "key": "glow.placement",
   "label": "Placement",
   "doc": "Its sequence's frame Frame, turned by Tilt about the x axis (90 degrees: lying flat), Height over the ground, under the ring"
  },
  {
   "key": "glow.brightness",
   "label": "Brightness",
   "doc": "Drawn while ring tick < Duration, its grey = Start - (ring tick x Lost per tick), one byte each: below 0 it wraps to 255 and the glow comes back bright. Additive: 0 adds nothing. The game stops at 20 = Start / Lost per tick, when it reaches 0"
  },
  {
   "key": "overlay.image",
   "label": "Projected image",
   "doc": "The target is redrawn with this image projected from the ring (a slide projector): a target point seen from the ring at screen (x, y) takes texel image corner + (x - 160, y - 120) + window / 2, inside the Width x Height window, with this palette"
  },
  {
   "key": "overlay.rgb",
   "label": "Light colour",
   "doc": "redrawn colour = texel x this / 128 (128 = the image as it is)"
  },
  {
   "key": "sparkle.window",
   "label": "Born",
   "doc": "A sparkle is born at each ring step while From tick <= ring tick <= To tick: Per tick sparkles per ring tick. The ring only spawns while it lives: until its ending flipbook is done (From tick + Last frame: ring tick 24 with the game's), later ticks do nothing"
  },
  {
   "key": "sparkle.colour",
   "label": "Colour",
   "doc": "Each piece's colour = its own x this / 128 (128: as it is), one value per channel"
  },
  {
   "key": "sparkle.speed",
   "label": "Speed",
   "doc": "Rolled once at birth, x then z then y, each min + random % (max - min + 1); then position += speed every tick (y goes down: a positive y falls)"
  },
  {
   "key": "mote.window",
   "label": "Born",
   "doc": "Motes are born while From tick <= ring tick <= To tick. The ring only spawns while it lives: until its ending flipbook is done (From tick + Last frame: ring tick 24 with the game's), later ticks do nothing"
  },
  {
   "key": "mote.count",
   "label": "How many",
   "doc": "Motes per ring tick = the count of the last rate whose from tick <= ring tick"
  },
  {
   "key": "mote.colour",
   "label": "Colour",
   "doc": "Each piece's colour = its own x this / 128 (128: as it is), one value per channel"
  },
  {
   "key": "mote.radius",
   "label": "Circle",
   "doc": "circle radius = target's radius x Times / Divided by (whole numbers), then at most At most; centred on the target"
  },
  {
   "key": "mote.angle",
   "label": "Place on the circle",
   "doc": "angle = min + random % (max - min + 1) (4096 = a full turn), rolled at birth"
  },
  {
   "key": "mote.drop",
   "label": "Drop",
   "doc": "Born below the ring by (the ring's height over the target's feet) x (min + random % (max - min + 1)) / Divided by, rolled at birth"
  },
  {
   "key": "mote.rise",
   "label": "Rise speed",
   "doc": "Rises min + random % (max - min + 1) every tick, rolled once (its first tick)"
  },
  {
   "key": "glint.window",
   "label": "Born",
   "doc": "Glints are born while From tick <= ring tick <= To tick, at the target's centre (every tick they go back there: the middle of its line anchor, at the height of its bounds centre). The ring only spawns while it lives: until its ending flipbook is done (From tick + Last frame: ring tick 24 with the game's), later ticks do nothing"
  },
  {
   "key": "glint.count",
   "label": "How many",
   "doc": "Glints per ring tick = the count of the last rate whose from tick <= ring tick"
  },
  {
   "key": "glint.style.grow",
   "label": "Growth",
   "doc": "width, height += this every tick while growing"
  },
  {
   "key": "glint.style.shrink",
   "label": "Shrinking",
   "doc": "width, height -= this every tick while shrinking"
  },
  {
   "key": "glint.style.centre_step",
   "label": "Centre colour step",
   "doc": "centre colour += this every tick while growing, -= while shrinking (bytes wrap past 255)"
  },
  {
   "key": "glint.style.tip_step",
   "label": "Tip colour step",
   "doc": "tip colour += this every tick while growing, -= while shrinking (bytes wrap past 255)"
  }
 ],
