 "tasks": [
  {
   "key": "emitter",
   "pool": "emitters",
   "size": 88,
   "function": "0x81FCD0",
   "doc": "One per action, on its target: follows the target, starts the ring, gives the HP, plays the sound.",
   "every_tick": [
    [
     "follow_target"
    ]
   ],
   "phases": [
    {
     "wait": [
      "tick_at_least",
      "$ring.start.delay"
     ],
     "do": [
      [
       "spawn",
       "ring"
      ]
     ]
    },
    {},
    {
     "wait": [
      "tick_at_least",
      "$emitter.heal_tick"
     ],
     "do": [
      [
       "heal"
      ],
      [
       "done"
      ]
     ]
    }
   ],
   "events": [
    [
     "sound_at",
     "$emitter.sound_tick",
     "$emitter.sound",
     "$emitter.sound_pan"
    ]
   ]
  },
  {
   "key": "ring",
   "pool": "particles",
   "size": 108,
   "function": "0x81FD90",
   "doc": "The light climbing in a helix around the target; it spawns the sparkles, motes and glints and draws the overlay and the glow.",
   "phases": [
    {
     "do": [
      [
       "spawning",
       1
      ],
      [
       "sequence",
       "$ring.seq"
      ],
      [
       "helix_start",
       "$ring.start.above",
       "$ring.radius.num",
       "$ring.radius.den",
       "$ring.radius.max",
       "$ring.climb.above",
       "$ring.climb.ticks",
       "$ring.steps.per_tick"
      ],
      [
       "overlay_start",
       "$overlay.rgb[0]",
       "$overlay.rgb[1]",
       "$overlay.rgb[2]",
       "$overlay.light_dist"
      ],
      [
       "hide_target"
      ]
     ]
    },
    {
     "wait": [
      "tick_at_least",
      "$ring.ending.tick"
     ],
     "do": [
      [
       "flipbook",
       "$ring.ending.seq",
       "$ring.ending.frames"
      ]
     ]
    },
    {
     "wait": [
      "flipbook_end"
     ],
     "do": [
      [
       "unblock_director"
      ],
      [
       "show_target"
      ],
      [
       "spawning",
       0
      ],
      [
       "overlay",
       0
      ],
      [
       "done"
      ]
     ]
    }
   ],
   "motion": [
    "helix",
    "$ring.steps.per_tick",
    "$ring.steps.angle"
   ],
   "step_spawns": [
    {
     "task": "sparkle",
     "if": "spawning",
     "window": [
      "$sparkle.window.first",
      "$sparkle.window.last"
     ],
     "place": [
      "at_parent"
     ]
    }
   ],
   "spawns": [
    {
     "task": "mote",
     "if": "spawning",
     "window": [
      "$mote.window.first",
      "$mote.window.last"
     ],
     "count": [
      "$mote.count.from[0]",
      "$mote.count.count[0]",
      "$mote.count.from[1]",
      "$mote.count.count[1]",
      "$mote.count.from[2]",
      "$mote.count.count[2]",
      "$mote.count.from[3]",
      "$mote.count.count[3]"
     ],
     "place": [
      "circle_drop",
      "$mote.angle.min",
      "$mote.angle.max",
      "$mote.drop.min",
      "$mote.drop.max",
      "$mote.drop.den",
      "$mote.radius.num",
      "$mote.radius.den",
      "$mote.radius.max"
     ]
    },
    {
     "pool": "glints",
     "if": "spawning",
     "window": [
      "$glint.window.first",
      "$glint.window.last"
     ],
     "count": [
      "$glint.count.from[0]",
      "$glint.count.count[0]",
      "$glint.count.from[1]",
      "$glint.count.count[1]",
      "$glint.count.from[2]",
      "$glint.count.count[2]",
      "$glint.count.from[3]",
      "$glint.count.count[3]"
     ],
     "place": [
      "glint",
      "glints",
      "$glint.style.ticks",
      "$glint.style.grow.w",
      "$glint.style.grow.h",
      "$glint.style.shrink.w",
      "$glint.style.shrink.h",
      "$glint.style.centre_step[0]",
      "$glint.style.centre_step[1]",
      "$glint.style.centre_step[2]",
      "$glint.style.tip_step[0]",
      "$glint.style.tip_step[1]",
      "$glint.style.tip_step[2]",
      "$glint.style.spin"
     ]
    }
   ],
   "draws": [
    {
     "part": "overlay",
     "if": "overlay",
     "draw": [
      "projector_overlay",
      "$overlay.image.tex_x",
      "$overlay.image.tex_y",
      "$overlay.image.clut_x",
      "$overlay.image.clut_y",
      "$overlay.image.width",
      "$overlay.image.height",
      "$overlay.skip_back_faces"
     ]
    },
    {
     "part": "ring",
     "draw": [
      "sprite",
      "$ring.colour.r",
      "$ring.colour.g",
      "$ring.colour.b",
      "$ring.size"
     ]
    },
    {
     "part": "glow",
     "while_tick_below": "$glow.brightness.ticks",
     "draw": [
      "ground_flipbook",
      "$glow.seq",
      "$glow.placement.tilt",
      "$glow.placement.height",
      "$glow.placement.frame",
      "$glow.brightness.start",
      "$glow.brightness.fade"
     ]
    }
   ]
  },
  {
   "key": "mote",
   "pool": "particles",
   "size": 108,
   "function": "0x820F70",
   "doc": "A flipbook rising at a random speed until its last frame.",
   "phases": [
    {
     "do": [
      [
       "flipbook",
       "$mote.seq",
       "$mote.frames"
      ],
      [
       "velocity_rise",
       "$mote.rise.min",
       "$mote.rise.max"
      ]
     ]
    },
    {
     "each_tick": [
      [
       "drift"
      ]
     ],
     "wait": [
      "flipbook_end"
     ],
     "do": [
      [
       "done"
      ]
     ]
    }
   ],
   "draws": [
    {
     "part": "motes",
     "draw": [
      "sprite",
      "$mote.colour.r",
      "$mote.colour.g",
      "$mote.colour.b",
      "$mote.size"
     ]
    }
   ]
  },
  {
   "key": "sparkle",
   "pool": "particles",
   "size": 108,
   "function": "0x8210C0",
   "doc": "A flipbook flying at a random velocity until its last frame.",
   "phases": [
    {
     "do": [
      [
       "flipbook",
       "$sparkle.seq",
       "$sparkle.frames"
      ],
      [
       "velocity_roll",
       "$sparkle.speed.x.min",
       "$sparkle.speed.x.max",
       "$sparkle.speed.y.min",
       "$sparkle.speed.y.max",
       "$sparkle.speed.z.min",
       "$sparkle.speed.z.max"
      ]
     ]
    },
    {
     "each_tick": [
      [
       "drift"
      ]
     ],
     "wait": [
      "flipbook_end"
     ],
     "do": [
      [
       "done"
      ]
     ]
    }
   ],
   "draws": [
    {
     "part": "sparkles",
     "draw": [
      "sprite",
      "$sparkle.colour.r",
      "$sparkle.colour.g",
      "$sparkle.colour.b",
      "$sparkle.size"
     ]
    }
   ]
  }
 ]
